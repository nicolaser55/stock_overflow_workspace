#!/usr/sbin/nft -f
# /etc/nftables.d/so_egress.nft (vm/nftables/so_egress.nft, 2026-11-19): outbound rules per account on so-vm.
# Loaded by the include line vm/setup_vm.sh adds to /etc/nftables.conf. Its own table only: Tailscale's tables and the
# input table inet so_filter are untouched. After an edit: sudo nft -c -f /etc/nftables.conf && sudo systemctl reload
# nftables. Never restart or stop nftables on this VM (it flushes Tailscale's rules, gotcha #96).
#
#   so_runner   only the local mail relay, 127.0.0.1:25 (design code runs as so_runner: no internet, no DNS)
#   so_agent    the VM's own loopback only, except the mail relay, the two proxies and the DNS stub; no internet
#   so_planner  only its proxy, 127.0.0.1:3129 (allow-list: the four Anthropic hosts)
#   so_git      only its proxy, 127.0.0.1:3130 (allow-list: github.com, api.github.com)
#   tinyproxy   DNS through the local stub, and TCP 443 to public addresses
#   postfix     its own loopback, and TCP 587 to public addresses (relayhost [smtp.gmail.com]:587)
# Private, link-local, CGNAT (tailnet) and VirtualBox NAT (10.0.2.0/24, which reaches nicodesktop's own loopback)
# ranges are refused for all six. Other accounts (root, nico, system services) are not restricted here.

table inet so_egress
delete table inet so_egress

table inet so_egress {
    set not_public4 {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
                     192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 }
    }
    set not_public6 {
        type ipv6_addr
        flags interval
        elements = { ::/127, ::ffff:0:0/96, 64:ff9b::/96, fc00::/7, fe80::/10, ff00::/8 }
    }

    chain output {
        type filter hook output priority filter; policy accept;
        # Replies of connections that were allowed (incoming SSH for so_agent included)
        ct state established,related accept
        meta skuid "so_runner" jump runner
        meta skuid "so_agent" jump agent
        meta skuid "so_planner" jump planner
        meta skuid "so_git" jump git
        meta skuid "tinyproxy" jump proxy
        meta skuid "postfix" jump relay
    }

    chain runner {
        ip daddr 127.0.0.1 tcp dport 25 accept
        counter reject
    }

    chain agent {
        tcp dport { 25, 53, 3129, 3130 } counter reject
        udp dport 53 counter reject
        ip daddr { 127.0.0.53, 127.0.0.54 } counter reject
        oif "lo" ip daddr 127.0.0.0/8 accept
        oif "lo" ip6 daddr ::1 accept
        counter reject
    }

    chain planner {
        ip daddr 127.0.0.1 tcp dport 3129 accept
        counter reject
    }

    chain git {
        ip daddr 127.0.0.1 tcp dport 3130 accept
        counter reject
    }

    chain proxy {
        ip daddr { 127.0.0.53, 127.0.0.54 } meta l4proto { tcp, udp } th dport 53 accept
        ip daddr != @not_public4 tcp dport 443 accept
        ip6 daddr != @not_public6 tcp dport 443 accept
        counter reject
    }

    chain relay {
        oif "lo" accept
        ip daddr != @not_public4 tcp dport 587 accept
        ip6 daddr != @not_public6 tcp dport 587 accept
        counter reject
    }
}
