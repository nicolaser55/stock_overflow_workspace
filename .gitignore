# PYTHON CACHES
__pycache__/
*.pyc
.ipynb_checkpoints/
# EDITABLE INSTALL METADATA (pip install -e .)
*.egg-info/
build/
# VIRTUAL ENVIRONMENTS
venv-main/
venv*/
.venv/
# MODEL FILES
models/
# CREDENTIALS (NEVER COMMIT)
GCS_key.json
*.json.key
.env
# DATA FILES (THE DATA LIVES UNDER SO_DATA_PATH, NEVER IN THE REPOSITORY)
*.csv
*.parquet
# EXCEPTION: RESEARCH RECORDS (CORRECTION LOGS, TRIAL LOG SNAPSHOTS) ARE VERSIONED, INCLUDING SUB-FOLDERS
!records/
!records/**/
!records/**/*.csv
# OS FILES
.DS_Store
Thumbs.db
# AGENT RUN LOGS (NOTEBOOK EXECUTION OUTPUT; THE EXECUTED NOTEBOOKS ARE THE RECORD)
logs/
# QUEUE JOB WORKTREES (scripts/run_queue.py)
.worktrees/
