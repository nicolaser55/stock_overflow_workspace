  <diagram name="Agentic system (2026-10-27)" id="so-agentic-2026-10-27">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1550" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Stock Overflow: agentic research system (design agreed 2026-10-27, not built)" style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="-50" width="1400" height="40" as="geometry" /></mxCell>
        <mxCell id="zn" value="NICOLAS (nico) — owner · outside the loop · holds the kill switch" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fff4e6;strokeColor=#d79b00;fontColor=#7a4a00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2080" height="160" as="geometry" /></mxCell>
        <mxCell id="zw" value="so_web — internet: YES · runs NO code on market data" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#eaf2fc;strokeColor=#6c8ebf;fontColor=#1f3d6b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="650" height="900" as="geometry" /></mxCell>
        <mxCell id="zc" value="so_code — internet: GitHub + package mirrors only · reads market data only via the runner" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#ecf6e8;strokeColor=#82b366;fontColor=#2d5a1e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="770" y="220" width="560" height="540" as="geometry" /></mxCell>
        <mxCell id="zr" value="so_runner — 🔒 PROTECTED CORE (only Nicolas changes it)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#fcecec;strokeColor=#b85450;fontColor=#7a1f1f;strokeWidth=3;dashed=0;" vertex="1" parent="1"><mxGeometry x="1410" y="220" width="710" height="900" as="geometry" /></mxCell>
        <mxCell id="zs" value="DATA &amp;amp; STORAGE" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#f4f4f4;strokeColor=#888888;fontColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="2080" height="220" as="geometry" /></mxCell>
        <mxCell id="n_stop" value="&lt;b&gt;Kill switch&lt;/b&gt;&lt;br&gt;sets STOP flag (from laptop)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fa6800;strokeColor=#C73500;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="70" y="60" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="n_ibkr" value="&lt;b&gt;Supplies ALL price data&lt;/b&gt;&lt;br&gt;downloads from IBKR on request → development view (via refresh) or quarantine (reserved)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fa6800;strokeColor=#C73500;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="n_core" value="&lt;b&gt;Owns the core&lt;/b&gt;&lt;br&gt;approves core PRs (code owner) · deploys judge commit" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fa6800;strokeColor=#C73500;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="290" height="80" as="geometry" /></mxCell>
        <mxCell id="n_mail" value="&lt;b&gt;Receives email&lt;/b&gt;&lt;br&gt;1 per full run · daily screening digest · failures · ALERTS" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fa6800;strokeColor=#C73500;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="n_eval" value="&lt;b&gt;Final evaluation (outside the system)&lt;/b&gt;&lt;br&gt;frozen design on forward / reserved data → “not rejected”, never “proven”" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fa6800;strokeColor=#C73500;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1230" y="60" width="330" height="80" as="geometry" /></mxCell>
        <mxCell id="n_warn" value="&lt;b&gt;Evaluation results never flow back to agents&lt;/b&gt;&lt;br&gt;otherwise that data is no longer unseen" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1590" y="60" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="reg" value="&lt;b&gt;Strategy registry&lt;/b&gt;&lt;br&gt;dedup key: family + mechanism&lt;br&gt;proposed → ranked → in progress → explored&lt;br&gt;links to trial ids" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="280" width="190" height="140" as="geometry" /></mxCell>
        <mxCell id="main" value="&lt;b&gt;Main orchestrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;state · picks next strategy · simple plan · chooses variants within family budget · marks explored&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#0050ef;strokeColor=#001DBC;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="280" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="rorch" value="&lt;b&gt;Research orchestrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;runs ≤3 agents in parallel · ranks · asks for more variants or declares done&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#0050ef;strokeColor=#001DBC;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="460" width="330" height="80" as="geometry" /></mxCell>
        <mxCell id="ragrp" value="Research agents (≤3, one strategy each)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=6;dashed=1;fillColor=none;strokeColor=#2d7a2d;fontColor=#2d5a1e;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="210" height="210" as="geometry" /></mxCell>
        <mxCell id="ra1" value="&lt;b&gt;Research agent 1&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#008a00;strokeColor=#005700;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="625" width="170" height="45" as="geometry" /></mxCell>
        <mxCell id="ra2" value="&lt;b&gt;Research agent 2&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#008a00;strokeColor=#005700;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="680" width="170" height="45" as="geometry" /></mxCell>
        <mxCell id="ra3" value="&lt;b&gt;Research agent 3&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#008a00;strokeColor=#005700;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="735" width="170" height="45" as="geometry" /></mxCell>
        <mxCell id="kb" value="Knowledge base (learning)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=6;dashed=1;fillColor=none;strokeColor=#9673a6;fontColor=#5a3d6b;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="600" width="360" height="150" as="geometry" /></mxCell>
        <mxCell id="less" value="&lt;b&gt;Lessons&lt;/b&gt;&lt;br&gt;evidence-linked (trial ids)&lt;br&gt;confidence · revisited when judge/data/costs change" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="325" y="630" width="160" height="105" as="geometry" /></mxCell>
        <mxCell id="fail" value="&lt;b&gt;Failure log&lt;/b&gt;&lt;br&gt;design + reason: costs · no edge · overfit · look-ahead · data" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="500" y="630" width="160" height="105" as="geometry" /></mxCell>
        <mxCell id="dagent" value="&lt;b&gt;Data agent&lt;/b&gt;&lt;br&gt;&lt;i&gt;NON-PRICE public data only (macro, calendars, filings…)&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#008a00;strokeColor=#005700;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="70" y="880" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="aud" value="&lt;b&gt;Auditor agent — VETO ONLY&lt;/b&gt;&lt;br&gt;&lt;i&gt;hunts leaks, bugs, implausible numbers · may downgrade a pass, never upgrade a fail&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#008a00;strokeColor=#005700;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="360" y="880" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="webnote" value="&lt;b&gt;Rules for so_web&lt;/b&gt;&lt;br&gt;• never downloads market prices (indexes and VIX included) → files a data request&lt;br&gt;• never fetches reserved data · tests ideas only through the logged screening path&lt;br&gt;• reads results, writes registry / knowledge base / staging only" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="1000" width="500" height="100" as="geometry" /></mxCell>
        <mxCell id="planq" value="&lt;b&gt;Experiment plan queue&lt;/b&gt;&lt;br&gt;plans from the main orchestrator" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="800" y="280" width="180" height="100" as="geometry" /></mxCell>
        <mxCell id="cod" value="&lt;b&gt;Codifier orchestrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;detailed plan · pre-registers protocol · queues runs and watches them (absorbs the old deployment agent)&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#0050ef;strokeColor=#001DBC;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1030" y="275" width="280" height="95" as="geometry" /></mxCell>
        <mxCell id="expreg" value="&lt;b&gt;Experiment registry&lt;/b&gt;&lt;br&gt;PROTOCOL.md pre-registered · candidate grid · ≤3 versions" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="800" y="420" width="180" height="110" as="geometry" /></mxCell>
        <mxCell id="coder" value="&lt;b&gt;Coding agent — exactly one&lt;/b&gt;&lt;br&gt;&lt;i&gt;experiments + non-core modules; reuses before writing&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#008a00;strokeColor=#005700;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1030" y="430" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="rev" value="&lt;b&gt;Code reviewer agent&lt;/b&gt;&lt;br&gt;&lt;i&gt;reviews; merges non-core PRs (integrity never depends on it)&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#008a00;strokeColor=#005700;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1030" y="560" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="codenote" value="&lt;b&gt;Rules for so_code&lt;/b&gt;&lt;br&gt;• works only on agent/** branches&lt;br&gt;• cannot change the core&lt;br&gt;• no data-folder access&lt;br&gt;• one writer = no conflicts" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="570" width="180" height="170" as="geometry" /></mxCell>
        <mxCell id="runq" value="&lt;b&gt;Run queue (hardened)&lt;/b&gt;&lt;br&gt;schema-validated jobs · safe ids · rejected/ · running/ resume · heartbeat" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1440" y="280" width="210" height="110" as="geometry" /></mxCell>
        <mxCell id="scrq" value="&lt;b&gt;Screening requests&lt;/b&gt;&lt;br&gt;fast daily-bar mode" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1440" y="420" width="210" height="80" as="geometry" /></mxCell>
        <mxCell id="trial" value="&lt;b&gt;Trial log · run index · manifests&lt;/b&gt;&lt;br&gt;AUTHORITATIVE · so_runner only · trial row per variant · judge version" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1440" y="540" width="210" height="130" as="geometry" /></mxCell>
        <mxCell id="reslog" value="&lt;b&gt;RESULTS_LOG.md&lt;/b&gt;&lt;br&gt;generated from run index" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1440" y="700" width="210" height="70" as="geometry" /></mxCell>
        <mxCell id="mail" value="&lt;b&gt;Notifier&lt;/b&gt;&lt;br&gt;email per full run · daily digest · failures · alert" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1440" y="870" width="210" height="90" as="geometry" /></mxCell>
        <mxCell id="judge" value="&lt;b&gt;Runner = the judge (code)&lt;/b&gt;&lt;br&gt;point-in-time view · engines · selection · baselines · look-ahead · costs" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#a20025;strokeColor=#6F0000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1700" y="275" width="260" height="75" as="geometry" /></mxCell>
        <mxCell id="sbx" value="&lt;b&gt;Sandbox process (design code)&lt;/b&gt;&lt;br&gt;no network · no data root · no records · no secrets → returns decisions only" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#a20025;strokeColor=#6F0000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1700" y="395" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="verd" value="&lt;b&gt;Verdict v(n)&lt;/b&gt;&lt;br&gt;return · consistency · baselines · look-ahead · multiple testing (N counts every screening variant)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#a20025;strokeColor=#6F0000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1700" y="520" width="260" height="85" as="geometry" /></mxCell>
        <mxCell id="dec" value="full run&lt;br&gt;passed?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#ffffff;strokeColor=#333333;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1760" y="640" width="140" height="100" as="geometry" /></mxCell>
        <mxCell id="srcreg" value="&lt;b&gt;Source registration&lt;/b&gt;&lt;br&gt;availability clock · truncation test · refuses reserved data" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#a20025;strokeColor=#6F0000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1700" y="880" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="pin" value="&lt;b&gt;Judge version&lt;/b&gt;&lt;br&gt;core runs from the main commit Nicolas deployed; a job brings only experiments/**" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1980" y="270" width="125" height="150" as="geometry" /></mxCell>
        <mxCell id="kchk" value="&lt;b&gt;Every step checks the STOP flag&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1980" y="440" width="125" height="90" as="geometry" /></mxCell>
        <mxCell id="stage" value="&lt;b&gt;Data staging&lt;/b&gt;&lt;br&gt;non-price downloads · unreadable by other agents" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="1250" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="dreq" value="&lt;b&gt;Data requests&lt;/b&gt;&lt;br&gt;“need price data for X” (file + email) → Nicolas" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="1250" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="dev" value="&lt;b&gt;Development view&lt;/b&gt;&lt;br&gt;SO_DATA_PATH · before the holdout · read by the runner only" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="560" y="1250" width="230" height="110" as="geometry" /></mxCell>
        <mxCell id="quar" value="&lt;b&gt;🔒 Quarantine — reserved data&lt;/b&gt;&lt;br&gt;SPY after each alert date · holdout window · QQQ / IWM / other indexes · pre-2005 SPY&lt;br&gt;no agent, no runner job" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="830" y="1240" width="270" height="140" as="geometry" /></mxCell>
        <mxCell id="gh" value="&lt;b&gt;GitHub (public, free)&lt;/b&gt;&lt;br&gt;main: PR · 0 approvals · code-owner review on core · CI tests + protected-paths&lt;br&gt;ruleset: agents push only agent/**&lt;br&gt;machine account (Write, not owner)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1130" y="1240" width="300" height="140" as="geometry" /></mxCell>
        <mxCell id="nas" value="&lt;b&gt;NAS&lt;/b&gt;&lt;br&gt;orchestrator state (survives restarts) · backups of trial log, run index, manifests" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1460" y="1250" width="210" height="110" as="geometry" /></mxCell>
