        <mxCell id="elt6" value="notifications" style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2260" y="417" width="290" height="22" as="geometry" /></mxCell>
        <mxCell id="ea7" value="" style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2200" y="451" width="1" height="1" as="geometry" /></mxCell>
        <mxCell id="eb7" value="" style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2250" y="451" width="1" height="1" as="geometry" /></mxCell>
        <mxCell id="elt7" value="forbidden flow" style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2260" y="440" width="290" height="22" as="geometry" /></mxCell>
        <mxCell id="bound" value="Three trust boundaries" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#ffffff;strokeColor=#888888;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2180" y="500" width="380" height="220" as="geometry" /></mxCell>
        <mxCell id="boundt" value="&lt;b&gt;1. Who decides success&lt;/b&gt; — fixed core code; agents cannot change the judge.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. What gets counted&lt;/b&gt; — every test on market data goes through the runner and is logged; code-running agents have no general internet.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. What agents see and change&lt;/b&gt; — three accounts, allow-list ACLs, firewall, rulesets." style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2195" y="530" width="355" height="185" as="geometry" /></mxCell>
        <mxCell id="ctl" value="Controls" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#ffffff;strokeColor=#888888;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2180" y="740" width="380" height="180" as="geometry" /></mxCell>
        <mxCell id="ctlt" value="• budget per role · hard global API-spend stop&lt;br&gt;• design budget per strategy family&lt;br&gt;• variants pre-registered (grid or new version)&lt;br&gt;• NTFS disk quota per agent account&lt;br&gt;• records backed up to the NAS before any unattended run" style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2195" y="770" width="355" height="145" as="geometry" /></mxCell>
        <mxCell id="stg" value="Staged autonomy" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#ffffff;strokeColor=#888888;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2180" y="940" width="380" height="180" as="geometry" /></mxCell>
        <mxCell id="stgt" value="&lt;b&gt;Stage 1&lt;/b&gt; — single supervised cycles; Nicolas reads every step&lt;br&gt;&lt;b&gt;Stage 2&lt;/b&gt; — unattended, low budgets&lt;br&gt;&lt;b&gt;Stage 3&lt;/b&gt; — budgets raised&lt;br&gt;&lt;br&gt;Each stage only after the previous one ran without integrity problems." style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2195" y="970" width="355" height="145" as="geometry" /></mxCell>
        <mxCell id="outc" value="Outcome language" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#ffffff;strokeColor=#888888;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2180" y="1140" width="380" height="280" as="geometry" /></mxCell>
        <mxCell id="outct" value="• the runner's verdict decides pass / fail&lt;br&gt;• the auditor may only veto a pass&lt;br&gt;• an unvetoed pass → ALERT; Nicolas evaluates outside the system&lt;br&gt;• success = “not rejected” on unseen data&lt;br&gt;• negative results are results and are kept&lt;br&gt;• expected: hundreds of designs, a steep multiple-testing bar, many documented negatives" style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2195" y="1170" width="355" height="240" as="geometry" /></mxCell>
