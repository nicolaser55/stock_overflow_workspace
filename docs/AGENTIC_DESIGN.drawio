        <mxCell id="bound" value="Three trust boundaries" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#ffffff;strokeColor=#888888;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="2180" y="500" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="boundt" value="&lt;b&gt;1. Who decides success&lt;/b&gt; — fixed core code from the deployed commit; design code cannot reach it (so_design).&lt;br&gt;&lt;br&gt;&lt;b&gt;2. What gets counted&lt;/b&gt; — only the runner reads market data; agents never see run folders or prices; web agents cannot run code.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. What agents see and change&lt;/b&gt; — accounts and ACLs; results only as grades; GitHub rulesets.&lt;br&gt;&lt;br&gt;&lt;i&gt;Accepted limit: models remember the period; only data after the freeze date is clean.&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2195" y="530" width="355" height="185" as="geometry" />
        </mxCell>
        <mxCell id="ctl" value="Controls" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#ffffff;strokeColor=#888888;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="2180" y="740" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ctlt" value="&lt;b&gt;Always on with real data:&lt;/b&gt; runner-only records · every attempt counted · deployed referee · results as grades · kill switch&lt;br&gt;&lt;b&gt;Before stage 2:&lt;/b&gt; so_design sandbox · firewall · quotas · GitHub rules · provider-side spend limit · NAS backups" style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2195" y="770" width="355" height="145" as="geometry" />
        </mxCell>
        <mxCell id="stg" value="Staged autonomy" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#ffffff;strokeColor=#888888;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="2180" y="940" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="stgt" value="&lt;b&gt;Stage 1&lt;/b&gt; — small version (page 2): planner + blind coder; Nicolas approves every PR and audits&lt;br&gt;&lt;b&gt;Stage 2&lt;/b&gt; — unattended, low budgets&lt;br&gt;&lt;b&gt;Stage 3&lt;/b&gt; — budgets raised&lt;br&gt;&lt;br&gt;Each stage only after the previous one ran without integrity problems." style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2195" y="970" width="355" height="145" as="geometry" />
        </mxCell>
        <mxCell id="outc" value="Outcome language" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#ffffff;strokeColor=#888888;fontColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="2180" y="1140" width="380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="outct" value="• the runner's verdict decides pass / fail&lt;br&gt;• the planner sees one grade + reason, no numbers&lt;br&gt;• the auditor may only veto a pass&lt;br&gt;• an unvetoed pass is frozen → paper trading&lt;br&gt;• outcomes: rejected / not rejected / not enough evidence yet&lt;br&gt;• negative results are kept&lt;br&gt;• expected: many documented negatives" style="whiteSpace=wrap;html=1;fontSize=12;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2195" y="1170" width="355" height="240" as="geometry" />
